# Local runtime configuration for API access and internal network settings.
#
# This file configures the simulator, Model Lab and the model search. The live trader does NOT read it: it has
# its own configuration file, live_trader.env in its data folder (`python live_trader.py --init` creates it), so
# the key here never decides whether the live trader trades real money. A view-only key is all these tools need.
# Copy this file to .env and fill in your local secrets before running the engine.

# Coinbase Advanced Trade uses a CDP Secret API key (Ed25519 or ECDSA).
# Either point COINBASE_KEY_FILE at the key JSON downloaded from the Coinbase
# Developer Platform, or set the key name and private key directly:
#   COINBASE_API_KEY_NAME=organizations/{org_id}/apiKeys/{key_id}
#   Ed25519: COINBASE_API_KEY_SECRET=<base64 secret>
#   ECDSA:   COINBASE_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\nYOUR PRIVATE KEY\n-----END EC PRIVATE KEY-----\n"
# An ECDSA PEM must be on one line with its newlines escaped as \n.
COINBASE_KEY_FILE=
COINBASE_API_KEY_NAME=
COINBASE_API_KEY_SECRET=
COINBASE_REQUIRED_PERMISSIONS=view
COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_ENABLED=false

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_ENABLED=false

LAN_PORT=8080

# The status dashboard of `python engine.py` (the live trader's portal is set in live_trader.env instead).
# DASHBOARD_HOST: 0.0.0.0 listens on every network interface, so other machines on your network can open it;
# 127.0.0.1 keeps it to this machine. Only clients on private networks are answered unless
# DASHBOARD_ALLOW_PUBLIC=true. Set DASHBOARD_PASSWORD to require a password (any user name).
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PASSWORD=
DASHBOARD_ALLOW_PUBLIC=false
