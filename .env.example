# Local runtime configuration for API access and internal network settings.
# Copy this file to .env and fill in your local secrets before running the engine.

COINBASE_AUTH_MODE=oauth
COINBASE_OAUTH_CLIENT_ID=
COINBASE_OAUTH_CLIENT_SECRET=
COINBASE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/callback
COINBASE_OAUTH_SCOPES=wallet:accounts:read,offline_access
COINBASE_OAUTH_ACCESS_TOKEN=
COINBASE_OAUTH_REFRESH_TOKEN=
COINBASE_BASE_URL=https://api.coinbase.com
COINBASE_ENABLED=false

KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_BASE_URL=https://api.kraken.com
KRAKEN_ENABLED=false

LAN_PORT=8080
LIVE_EXECUTION_ACTIVE=false
