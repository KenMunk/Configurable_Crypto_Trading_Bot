{
  "ticker": "BTC",
  "product_id": "BTC-USD",
  "strategy_horizon": "MACRO_TREND",
  "execution_platform": "COINBASE_ADVANCED",
  "period_granularity": "FIFTEEN_MINUTE",
  "indicators": {
    "fast_ema": {
      "type": "EMA",
      "period": "10d",
      "description": "10d trend."
    },
    "slow_ema": {
      "type": "EMA",
      "period": "100d",
      "description": "100d macro trend."
    }
  },
  "strategy": {
    "direction": "LONG_ONLY",
    "market_regime": "TREND_FOLLOWING",
    "entry_signal": {
      "description": "The 10d EMA is above the 100d EMA.",
      "all": [
        "fast_ema > slow_ema"
      ]
    },
    "exit_signal": {
      "description": "Exit when the 10d EMA falls below the 100d EMA, at the +2,000% profit target, or at the 50% drawdown limit.",
      "any": [
        "fast_ema < slow_ema"
      ],
      "hard_stop_trigger": false,
      "profit_lock_target": 20.0
    }
  },
  "friction_model": {
    "exchange_fee_coverage_enabled": true,
    "commission_rate_source": "exchange_api",
    "fee_buffer_multiplier": 1.0,
    "fallback_commission_rate": 0.005,
    "tax_buffer_rate": 0.313,
    "slippage_buffer": 0.0025,
    "liquidity_fee_buffer": 0.5,
    "rebalancing_cost_adjustment": true
  },
  "capital_allocation": {
    "starting_capital": 2000,
    "target_position_fraction": 1.0,
    "value_harvesting_rate": 0.1,
    "allocation_policy": "convert_harvested_profit_to_configured_trading_currency"
  },
  "tax_allocation": {
    "enabled": true,
    "rate": 0.1,
    "schedule": {
      "interval": "MONTHLY",
      "day_of_month": 1,
      "time_utc": "00:00:00"
    },
    "description": "Configurable tax reserve allocation that converts harvested gains into the configured trading currency on a scheduled interval."
  },
  "execution": {
    "order_style": "LIMIT_WITH_FRICTION_MARGIN",
    "live_execution_active": false,
    "max_orders_per_day": 12,
    "rebalance_interval_minutes": 15,
    "primary_exchange": "COINBASE_ADVANCED"
  },
  "safeguards": {
    "live_execution_active": false,
    "use_hard_stop": false,
    "hard_stop_percentage": 0.03,
    "minimum_net_profit_gate": 0.05,
    "max_drawdown_limit": 0.5,
    "volatility_cap": 0.08,
    "risk_budget_per_trade": 0.02
  }
}
