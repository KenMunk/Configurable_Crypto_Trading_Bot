# The live trader's own configuration: its Coinbase API key and its runtime settings.
#
# This file is the live trader's alone. The simulator reads the .env file in the program folder and never this
# one, and the live trader never reads that .env, so the two can hold different keys: typically a view-only key
# for the simulator, and here the key the live trader should trade with.
#
# `python live_trader.py --init` copies this template to live_trader.env in the data folder. Edit it there.
#
# THE KEY DECIDES HOW IT TRADES: a key with the Trade permission makes the live trader trade REAL MONEY; a
# view-only key makes it paper-trade. Never give the key the Transfer permission.
#
# RISK WARNING: the live trader is a speculative automated trader; you can lose your entire investment.

# A CDP Secret API key (Ed25519 or ECDSA). Either point COINBASE_KEY_FILE at the key JSON (a relative path starts
# from the data folder), or set the key name and private key directly:
#   COINBASE_API_KEY_NAME=organizations/{org_id}/apiKeys/{key_id}
#   Ed25519: COINBASE_API_KEY_SECRET=<base64 secret>
#   ECDSA:   COINBASE_API_KEY_SECRET="-----BEGIN EC PRIVATE KEY-----\nYOUR PRIVATE KEY\n-----END EC PRIVATE KEY-----\n"
# Comments must be on their own line: an inline comment becomes part of the value.
COINBASE_KEY_FILE=
COINBASE_API_KEY_NAME=
COINBASE_API_KEY_SECRET=
COINBASE_BASE_URL=https://api.coinbase.com

# true: paper-trade even when the key above can trade.
FORCE_PAPER_TRADING=false

# The web portal (http://<this machine>:LAN_PORT/portal). DASHBOARD_HOST 0.0.0.0 lets other machines on your
# network open it; 127.0.0.1 keeps it to this machine. Only private-network clients are answered unless
# DASHBOARD_ALLOW_PUBLIC=true. Set DASHBOARD_PASSWORD to require a password (any user name).
LAN_PORT=8080
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PASSWORD=
DASHBOARD_ALLOW_PUBLIC=false
